diff --git a/menu.cpp b/menu.cpp
index 9577174..960cd06 100644
--- a/menu.cpp
+++ b/menu.cpp
@@ -1167,6 +1167,89 @@ void HandleUI(void)
 	static pid_t ttypid = 0;
 	static int ttystatus = 0;
 	static int has_fb_terminal = 0;
+
+	// Releasing the menu button switches the framebuffer overlay off (see the KEY_F12
+	// handler): the OSD is drawn by the core and would otherwise sit underneath. With a
+	// replacement GUI that leaves it running invisibly, so the overlay is restored as soon
+	// as the OSD closes again.
+	if (cfg.gui[0] && ttypid && !user_io_osd_is_visible() && !video_fb_state())
+	{
+		video_fb_enable(1);
+	}
+
+	// Holding the menu button inside a running core returns to the main menu, where the
+	// replacement GUI starts again. Without it there is no quick way back from a game — the
+	// stock OSD only offers the reset entry, which is far from obvious.
+	if (cfg.gui[0] && !is_menu())
+	{
+		static unsigned long gui_exit_at = 0;
+		const bool menu_held = menu_key && !(menu_key & UPSTROKE) && (menu_key & 0xFFFF) == KEY_MENU;
+
+		if (!menu_held)
+		{
+			gui_exit_at = 0;
+		}
+		else if (!gui_exit_at)
+		{
+			gui_exit_at = GetTimer(1500);
+		}
+		else if (CheckTimer(gui_exit_at))
+		{
+			gui_exit_at = 0;
+			printf("Menu button held, returning to the menu core\n");
+			fpga_load_rbf("menu.rbf");
+		}
+	}
+
+	// Start the configured replacement GUI, and bring it back if it ever goes away while the
+	// menu core is up. This mirrors MENU_SCRIPTS_FB: only that path enables the framebuffer
+	// overlay the GUI draws into. The cooldown keeps a GUI that fails to run from spinning.
+	//
+	// The GUI's own "Start MiSTer Core" setting exits it and drops this marker so the stock
+	// menu stays on screen instead of being covered again a few seconds later. It lives in
+	// /tmp, so a reboot is what brings the GUI back.
+	{
+		static unsigned long gui_next_try = 0;
+		static bool gui_first = true;
+		static bool gui_missing = false;
+
+		if (cfg.gui[0] && is_menu() && cfg.fb_terminal && !ttypid && !gui_missing &&
+		    !FileExists("/tmp/mister-pat-suspend-gui") &&
+		    (gui_first || CheckTimer(gui_next_try)))
+		{
+			const char *gui_path = getFullPath(cfg.gui);
+			if (!FileExists(gui_path))
+			{
+				gui_missing = true;
+				printf("GUI not found: %s\n", gui_path);
+			}
+			else
+			{
+				gui_first = false;
+				gui_next_try = GetTimer(5000);
+				printf("Starting GUI: %s\n", gui_path);
+
+				static char gui_cmd[1024 * 2];
+				sprintf(gui_cmd, "#!/bin/bash\nexport LC_ALL=en_US.UTF-8\nexport HOME=/root\n%s\n", gui_path);
+
+				video_chvt(2);
+				video_fb_enable(1);
+				vga_nag();
+
+				unlink("/tmp/script");
+				FileSave("/tmp/script", gui_cmd, strlen(gui_cmd));
+				ttystatus = 0;
+				ttypid = fork();
+				if (!ttypid)
+				{
+					execl("/sbin/agetty", "/sbin/agetty", "-a", "root", "-l", "/tmp/script",
+					      "--nohostname", "-L", "tty2", "linux", NULL);
+					exit(0);
+				}
+				menustate = MENU_SCRIPTS_FB2;
+			}
+		}
+	}
 	static unsigned long flash_timer = 0;
 	static int flash_state = 0;
 	static uint32_t dip_submenu;
diff --git a/video.cpp b/video.cpp
index 7f464da..cea2d7f 100644
--- a/video.cpp
+++ b/video.cpp
@@ -1936,6 +1936,32 @@ int video_get_edid(uint8_t **buf, int *size)
 	return edid_version;
 }
 
+// Works out from the EDID whether the display speaks HDMI or plain DVI.
+//
+// Upstream decides this inside get_edid_vmode(), which only runs while the video mode is
+// itself being derived from the EDID. Setting video_mode in the INI therefore switches the
+// DVI detection off as a side effect, and a monitor on a DVI adapter is then sent HDMI
+// signalling with audio packets and stays dark. The two settings have nothing to do with
+// each other, so this decides it on its own.
+//
+// Returns true when the answer is DVI and the ADV7513 has to be told about it.
+static bool detect_dvi_mode()
+{
+	if (cfg.dvi_mode != 2) return false;   // the INI already says which one
+
+	if (!is_edid_valid())
+	{
+		cfg.dvi_mode = 0;                  // no EDID: HDMI is the safer assumption
+		return false;
+	}
+
+	// A CEA-861 extension block advertising basic audio is what makes a sink HDMI.
+	// A display with no extension block at all - a DVI monitor - fails this and is DVI.
+	cfg.dvi_mode = (edid[0x80] == 2 && edid[0x81] == 3 && (edid[0x83] & 0x40)) ? 0 : 1;
+	printf("EDID: %s display detected.\n", cfg.dvi_mode == 1 ? "DVI" : "HDMI");
+	return cfg.dvi_mode == 1;
+}
+
 static int get_edid_vmode(vmode_custom_t *v)
 {
 	read_edid();
@@ -1953,11 +1979,7 @@ static int get_edid_vmode(vmode_custom_t *v)
 		return 0;
 	}
 
-	if (cfg.dvi_mode == 2)
-	{
-		cfg.dvi_mode = (edid[0x80] == 2 && edid[0x81] == 3 && (edid[0x83] & 0x40)) ? 0 : 1;
-		if (cfg.dvi_mode == 1) printf("EDID: using DVI mode.\n");
-	}
+	detect_dvi_mode();
 
 	unsigned char flags = x[17];
 	if (flags & 0x80)
@@ -2695,6 +2717,10 @@ void video_init()
 	hdmi_config_init();
 	read_edid(true);
 
+	// hdmi_config_init() already wrote the HDMI/DVI register, and it had to guess before the
+	// EDID was readable. If the display turns out to be DVI, that register needs rewriting.
+	if (detect_dvi_mode()) hdmi_config_audio();
+
 	hdmi_config_set_hdr();
 	video_mode_load();
 
@@ -2720,6 +2746,9 @@ void video_reinit()
 
 	printf("*** Video re-initialization.\n");
 
+	// The EDID is already in hand here, so the right mode can be chosen before the register
+	// is written rather than corrected afterwards.
+	detect_dvi_mode();
 	hdmi_config_init();
 	// re-init resets 0x17/0x3B/0x3C - re-apply, or video stays black if any of them changed
 	hdmi_invalidate_mode_cache();
