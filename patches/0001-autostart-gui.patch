diff --git a/Makefile b/Makefile
index 233c5e5..c83032c 100644
--- a/Makefile
+++ b/Makefile
@@ -7,6 +7,9 @@ MAKEFLAGS += "-j $(shell nproc)"
 BASE    = arm-none-linux-gnueabihf
 
 CC      = $(BASE)-gcc
+# Linking through g++ so -static-libstdc++ takes effect: our toolchain's libstdc++ is
+# newer than the device's (GLIBCXX_3.4.28), so it must not be linked dynamically.
+CXX     = $(BASE)-g++
 LD      = $(BASE)-ld
 STRIP   = $(BASE)-strip
 
@@ -16,6 +19,10 @@ else
 	Q := @
 endif
 
+# The stock toolchain defaults to ARMv7-A with NEON; ours does not, which would
+# compile the unmaintained scalar paths instead.
+ARCH_FLAGS = -mcpu=cortex-a9 -mfpu=neon -mfloat-abi=hard
+
 INCLUDE	= -I./
 INCLUDE	+= -I./lib/libco
 INCLUDE	+= -I./lib/miniz
@@ -50,8 +57,8 @@ OBJ	= $(C_SRC:%.c=$(BUILDDIR)/%.c.o) $(CPP_SRC:%.cpp=$(BUILDDIR)/%.cpp.o) $(IMG:
 DEP	= $(C_SRC:%.c=$(BUILDDIR)/%.c.d) $(CPP_SRC:%.cpp=$(BUILDDIR)/%.cpp.d)
 
 DFLAGS	= $(INCLUDE) -D_7ZIP_ST -DPACKAGE_VERSION=\"1.3.3\" -DHAVE_LROUND -DHAVE_STDINT_H -DHAVE_STDLIB_H -DHAVE_SYS_PARAM_H -DENABLE_64_BIT_WORDS=0 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE64_SOURCE -DVDATE=\"`date +"%y%m%d"`\"
-CFLAGS	= $(DFLAGS) -Wall -Wextra -Wno-strict-aliasing -Wno-stringop-overflow -Wno-stringop-truncation -Wno-format-truncation -Wno-psabi -Wno-restrict -c
-LFLAGS	= -lc -lstdc++ -lm -lrt $(IMLIB2_LIB) -Llib/bluetooth -lbluetooth -lpthread
+CFLAGS	= $(ARCH_FLAGS) $(DFLAGS) -Wall -Wextra -Wno-strict-aliasing -Wno-stringop-overflow -Wno-stringop-truncation -Wno-format-truncation -Wno-psabi -Wno-restrict -c
+LFLAGS	= $(ARCH_FLAGS) -static-libstdc++ -static-libgcc -lc -lm -lrt $(IMLIB2_LIB) -Llib/bluetooth -lbluetooth -lpthread
 
 OUTPUT_FILTER = sed -e 's/\(.[a-zA-Z]\+\):\([0-9]\+\):\([0-9]\+\):/\1(\2,\ \3):/g'
 
@@ -67,7 +74,7 @@ endif
 
 $(BUILDDIR)/$(PRJ): $(OBJ)
 	$(Q)$(info $@)
-	$(Q)$(CC) -o $@ $+ $(LFLAGS)
+	$(Q)$(CXX) -o $@ $+ $(LFLAGS)
 	$(Q)cp $@ $@.elf
 ifneq ($(DEBUG),1)
 	$(Q)$(STRIP) $@
